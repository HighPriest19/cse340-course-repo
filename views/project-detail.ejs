<%- include('partials/header') %>
    <h1><%= project.name %></h1>
    <p><%= project.description %></p>
    
    <h3>Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></h3>
    
    <h3>Categories</h3>
    <% if (categories.length > 0) { %>
        <ul>
            <% categories.forEach(category => { %>
                <li><a href="/category/<%= category.id %>"><%= category.name %></a></li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No categories assigned to this project.</p>
    <% } %>

    <% if (isAuthenticated) { %>
        <div class="volunteer-actions">
            <% if (isVolunteer) { %>
                <p class="volunteer-status">You are volunteering for this project.</p>
                <a href="/project/<%= project.id %>/unvolunteer" class="btn-cancel">Remove Volunteer</a>
            <% } else { %>
                <a href="/project/<%= project.id %>/volunteer" class="btn-submit">Volunteer for this project</a>
            <% } %>
        </div>
    <% } %>
    
    <div class="project-actions">
        <a href="/edit-project/<%= project.id %>" class="btn-edit">Edit Project</a>
    </div>
<%- include('partials/footer', { year: year }) %>