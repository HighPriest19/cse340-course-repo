<%- include('partials/header') %>
    <h1>Create New Organization</h1>

    <% if (errors && errors.length > 0) { %>
        <div class="errors">
            <h3>Please fix the following errors:</h3>
            <ul>
                <% errors.forEach(error => { %>
                    <li><%= error %></li>
                <% }) %>
            </ul>
        </div>
    <% } %>

    <form method="POST" action="/new-organization" class="organization-form">
        <div class="form-group">
            <label for="name">Organization Name:</label>
            <input type="text" id="name" name="name" value="<%= name || '' %>" required>
        </div>

        <div class="form-group">
            <label for="description">Description:</label>
            <textarea id="description" name="description" rows="5" required><%= description || '' %></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">Create Organization</button>
            <a href="/organizations" class="btn-cancel">Cancel</a>
        </div>
    </form>
<%- include('partials/footer', { year: year }) %>