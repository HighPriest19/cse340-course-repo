<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Service Portal</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/organizations">Organizations</a></li>
                <li><a href="/projects">Projects</a></li>
                <li><a href="/categories">Categories</a></li>
                <% if (isAuthenticated) { %>
                    <li><a href="/dashboard">Dashboard</a></li>
                <% } %>
            </ul>
            <ul class="nav-auth">
                <% if (isAuthenticated) { %>
                    <li class="nav-welcome">Welcome, <%= user.name %></li>
                    <li><a class="btn-logout" href="/logout">Logout</a></li>
                <% } else { %>
                    <li><a class="btn-login" href="/login">Login</a></li>
                    <li><a class="btn-register" href="/register">Register</a></li>
                <% } %>
            </ul>
        </nav>
    </header>
    <main>