<%- include('partials/header') %>
    <h1>Service Categories</h1>
    <p>Explore the different types of service projects available:</p>
    <p><a class="btn-submit" href="/new-category">Add New Category</a></p>
    <% if (categories.length > 0) { %>
        <ul>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.id %>"><%= category.name %></a>
                    <a class="small-link" href="/edit-category/<%= category.id %>">Edit</a>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No categories have been added yet.</p>
    <% } %>
<%- include('partials/footer', { year: year }) %>