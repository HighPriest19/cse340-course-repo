<%- include('partials/header') %>
    <h1>Projects</h1>
    <p>Check out our available service project opportunities:</p>
    <% if (projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li><a href="/project/<%= project.id %>"><%= project.name %></a> - <%= project.organization_name %></li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No projects found.</p>
    <% } %>
<%- include('partials/footer', { year: year }) %>